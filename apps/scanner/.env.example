# Port the API listens on
PORT=4100
# Comma-separated origins allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Set to "true" only when running behind a trusted reverse proxy / CDN
TRUST_PROXY=false
# Optional: enables Core Web Vitals via Google PageSpeed Insights
# PSI_API_KEY=your-google-pagespeed-api-key
# Optional tuning
# MAX_PAGES=8
# MAX_LINKS=60
# MAX_CONCURRENT_SCANS=3
# RATE_LIMIT_MAX=6
# DEV ONLY — allow scanning localhost/private networks. NEVER enable in production.
# ALLOW_PRIVATE_HOSTS=false
# Browser step (Playwright). Disable with ENABLE_BROWSER=false
# ENABLE_BROWSER=true
# BROWSER_CONCURRENCY=2
# Needed only when running as root in a container
# BROWSER_NO_SANDBOX=false

# PDF reports are rendered from the web app's print view.
# Auto-detected from CORS_ORIGIN; set explicitly if the web app runs elsewhere.
# WEB_URL=http://localhost:3001
# How the browser that renders the PDF reaches this API (default http://localhost:PORT)
# PUBLIC_API_URL=http://localhost:4100

# Domains that asked to opt out of scanning (comma-separated; subdomains included)
# BLOCKED_HOSTS=example.org,another.example
